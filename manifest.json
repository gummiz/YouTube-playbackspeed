{
  "manifest_version": 3,
  "name": "YouTube Playback Speed Control Extension",
  "description": "This extension allows to control YouTube video playback speed using keyboard shortcuts.",
  "version": "1.3.0",
  "permissions": ["activeTab", "scripting", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "commands": {
    "change_playback_speed": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "Cycle YouTube Video Playback Speed"
    },
    "reset_speed": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Reset YouTube Video Playback Speed to 1x"
    }
  },

  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
